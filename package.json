{
  "name": "conclave",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@babel/core": "7.26.9",
    "prettier": "3.9.6",
    "turbo": "^2.11.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@babel/core": "$@babel/core"
  }
}
